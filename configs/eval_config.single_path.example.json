{
  "algorithm": "ppo",
  "seed": 42,
  "deterministic": true,
  "device": "cpu",
  "evaluation_mode": "single_path_backtest",
  "target_mode": "explicit_episode_refs",
  "target_partition": null,
  "target_fold_id": null,
  "target_episode_refs": [
    {
      "scope": "partition",
      "partition": "val",
      "source_rel": "BTC_USDT_15m_price_data.parquet",
      "fold_id": null
    }
  ],
  "benchmark_mode": "buy_and_hold",
  "startup_policy": "fresh_only",
  "max_eval_episodes": 1,
  "max_eval_steps": 4096,
  "write_step_trace": true,
  "backtest_metrics": [
    "total_return",
    "annualized_return",
    "annualized_volatility",
    "sharpe_ratio",
    "max_drawdown",
    "calmar_ratio",
    "num_steps",
    "num_trades",
    "win_rate",
    "avg_trade_return",
    "final_equity"
  ]
}
